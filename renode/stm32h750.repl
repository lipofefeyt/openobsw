// STM32H750VBT6 bare-metal platform for Renode
//
// Cortex-M7, 128 KB internal flash at 0x08000000, 512 KB AXI SRAM at
// 0x20000000 (linker DTCM/RAM region).  USART3 on PD8/PD9, 115200 baud.
//
// With -DOBSW_RENODE=ON the firmware skips system_clock_init(), so RCC and
// GPIOD only receive obsw_uart_init() register writes — stub memories suffice.
// USART3 frequency matches APB1 after PLL1: 120 MHz.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x20000

// 512 KB covers DTCM (0x20000000) and the AXI SRAM window used by the linker
ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000

// USART3 — PD8(TX)/PD9(RX) — wire protocol v3 via socket terminal
// IRQ omitted: driver is polling-only
usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 120000000

// ── Stub peripheral regions ──────────────────────────────────────────────────
// Absorb obsw_uart_init() writes (RCC clock-enable, GPIOD pin-mux) without
// faulting.  Reads return 0; no spin-wait loops exist in the Renode build.

rcc: Memory.MappedMemory @ sysbus 0x58024400
    size: 0x400

gpiod: Memory.MappedMemory @ sysbus 0x58020C00
    size: 0x400
